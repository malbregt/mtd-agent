[Unit]
Description=MTD Agent — uniek mDNS-alias (mtd-<serial>.local) naast de primaire hostname
After=network-online.target avahi-daemon.service
Wants=network-online.target
Requires=avahi-daemon.service

[Service]
Type=simple
ExecStart=/opt/mtd-agent/scripts/publish-alias.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
